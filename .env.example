# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://crimenet:crimenet_secret@localhost:5432/crimenet

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=crimenet_neo4j
NEO4J_DATABASE=neo4j

# ── AI Copilot (optional — system works fully without it) ─────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 chars, random, keep secret
JWT_SECRET_KEY=change-me-to-a-random-32-char-secret

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
DATASET_PATH=./dataset
